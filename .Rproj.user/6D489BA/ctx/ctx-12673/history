# packages ####
library (sf)         # modern spatial data management
library (lme4)
library (MuMIn)
# library (rsquare)
library (tidyverse)  # tidy umgebung
library (crayon)     # string colours
library (r2glmm)
library (openxlsx)                                    #needed to read and store excel files
# library (gridExtra)
# load data ####
o_plots <- st_read ("o_plots_processed.gpkg")
# GLMM ####
multiple_GLMM <- function (global.model = NULL, dredge.max = NULL, AIC_delta = 3, graph.arrange = 2, plot_resids = TRUE) {
# multiple regression workflow
#
# takes a global model of class glmm or glm, performs dredging and model averaging and puts out
# - the dredge table
# - the average model
# - qq plots of all models included in the average model with R² (marginal; delta) and AICc
modfam <- family (global.model)$family
dredge_object <- dredge (global.model, m.max = dredge.max)
if (length (dredge_object$delta [dredge_object$delta < AIC_delta ]) > 1){
average_model <- model.avg (dredge_object, subset = delta < AIC_delta, fit = TRUE)
no_best_models <- length (subset (dredge_object, subset = delta < AIC_delta) [,1])
best_models <- getCall (dredge_object, c (1 : no_best_models))
summary_average_model <- summary (average_model)
} else {
average_model <- getCall (dredge_object, 1)
no_best_models <- 1
best_models <- list ("0" = average_model)
temp_model <- glmer(average_model, family = modfam, data = global.model@frame)
summary_average_model <- list()
summary_average_model $ coefmat.full <- summary (temp_model) $ coefficients
}
names (best_models) <- paste ("model_", names(best_models), sep = "")
par (mfrow = c (graph.arrange, ceiling(no_best_models/graph.arrange) ) )
the_models <- list ()
the_residuals <- list ()
for (i in 1 : no_best_models) {
print (modfam)
the_models [[i]] <- glmer(best_models[[i]], family = modfam, data = global.model@frame)
the_residuals [[i]] <- resid (the_models [[i]], type="pearson")
}
the_plots <- "no residual qq-plots produced"
my_r2 <- c()
for (i in 1 : no_best_models) {
my_r2 [i] <- round (r.squaredGLMM (the_models [[i]]) [1,1], digits = 3)
if (plot_resids == TRUE) {
qqnorm (the_residuals [[i]], main = names (best_models[i]))
qqline (the_residuals [[i]])
text (x = -0.5, y = max(the_residuals [[i]])*0.9,
labels = paste ("R²: ", my_r2 [i] ) )
text (x = -0.5, y = max(the_residuals [[i]])*0.7,
labels = paste ("AICc: ", round (dredge_object$AICc [i], digits = 1) ) )
}
}
if (plot_resids == TRUE) the_plots <- recordPlot ()
return (list (dredge_table = dredge_object [1:15],
average_model = summary_average_model,
model_validation_QQplots = the_plots,
"R2_range" = c (min (my_r2), max (my_r2)),
"IBL FUNCTIONS"))
}
# whole dataset ####
species_number_global <- glmer (NO_ORTHO ~ LUI + I((LUI)^2) + shannon + #heatload_mean +
heatload_range + TPI_range #* TPI_mean
+  elevation + (1|GEBIET),
data = o_plots, family = "poisson", na.action = na.fail)
summary(species_number_global)
species_number_regression <- multiple_GLMM (global.model = species_number_global,
dredge.max = 8,
AIC_delta = 3,
graph.arrange = 3)
species_number_regression
# specialists
specialists_number_global <- glmer (NO_ORTHO_specialists ~ LUI + I((LUI)^2) + shannon + heatload_mean + heatload_range + TPI_range * TPI_mean +  elevation + (1|GEBIET),
data = o_plots, family = "poisson", na.action = na.fail)
summary(specialists_number_global)
specialists_number_regression <- multiple_GLMM (global.model =  specialists_number_global,
dredge.max = 8,
AIC_delta = 3,
graph.arrange = 3)
specialists_number_regression
# generalists
generalists_number_global <- glmer (NO_ORTHO_generalists ~ LUI + I((LUI)^2) + shannon + heatload_mean + heatload_range + TPI_range * TPI_mean +  elevation + (1|GEBIET),
data = o_plots, family = "poisson", na.action = na.fail)
summary(generalists_number_global)
generalists_number_regression <- multiple_GLMM (generalists_number_global,
dredge.max = 8,
AIC_delta = 3,
graph.arrange = 2,
plot_resids = F)
generalists_number_regression
# Zielvariable CFI
