plot_rows  <- 3                      # wie viele Plots sollen übereinander dargestellt werden?
plot_cols  <- 1                      # wie viele Plots sollen nebeneinander dargestellt werden?
# plot_distance_x <- 10                # abstand der plots voneinander (wenn mehere gleichzeitig übereinander dargestellt werden)
# plot_distance_y <- 10                # abstand der plots voneinander (wenn mehere gleichzeitig nebeneinander dargestellt werden)
line_size  <- 0.3                    # Linienstärke der Achsen
x_lab <- "Landuse Index"
y_lab <- "Species Number"
speciesnumber_landuse <- list ()
for (i in levels (o_plots $ TYPE)) {
plot_data <- o_plots %>%
as_tibble() %>%
filter (TYPE == i)
plot_no <- data.frame(matrix (ncol = 3))
plot_no [1,] <- c ("a", "b", "c")
colnames (plot_no) <- levels (o_plots $ TYPE)
label <- plot_no [,i]
if (i == "wetland") {
plot_data $ LUI <- plot_data$LUI %>% na_if (0)
plot_data $ LUI [is.na (plot_data $ LUI)] <- runif(22)/4
}
speciesnumber_landuse [[i]] <- plot_data %>%
ggplot (mapping = aes (x = LUI, y = NO_ORTHO)) +
geom_point (shape = 19,                                       # shape: number (0 - 25) for different *point* symbols
fill = "black",
size = 1,
aes (size = )) +
IBL_y_scale(limits = c (0,22)) +
IBL_x_scale(limits = c(0, 5)) +
labs (x = x_lab, y = y_lab) +
IBL_theme ()
speciesnumber_landuse [[i]] <- speciesnumber_landuse [[i]] %>% IBL_title(paste0 (label, ") ", plot_data $TYPE [1]), x = 0, y = 1)
}
IBL_draw_plot (speciesnumber_landuse)
