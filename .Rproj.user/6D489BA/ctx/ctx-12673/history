geom_errorbar(aes (ymin = CFI_best - SE_CFI_best, ymax = CFI_best + SE_CFI_best), width = 0.3) +
IBL_y_scale (sides = "l", air = F, limits = c (0, 32), major_y = 3) +
labs (x = "", y = "Farmland index") +
IBL_signi (c ("a", "b", "a")) +
