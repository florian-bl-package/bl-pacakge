#' @param title the title for the plot
#' @param x the x-position of the title. If the x-axis is a continuous scale and xrel is set to "TRUE", this is a relative position (e.g. at 50 % of the x-axis). Otherwise, this is an absolute position (e.g. at x = .5).
#' @param y the y-position of the title. If the y-axis is a continuous scale and yrel is set to "TRUE", this is a relative position (e.g. at 90 % of the y-axis). Otherwise, this is an absolute position (e.g. at y = .9).
#' @param xrel logical. relative or absolute x-position?
#' @param yrel logical. relative or absolute y-position?
#' @param font the font of the title
#' @param text_size the text size of the title
#' @param ... additional arguments, for detail see '?geom_text'.
#'
#' @export
IBL_title <- function (plot = ggplot2::last_plot (),
title = "plot title",
x = .5,
y = .97,
xrel = T,
yrel = T,
font = "ChantillyLH",
text_size = 5,
...) {
if (is.null(layer_scales(plot)$y$limits)){
yrel = F
}
if (is.null(layer_scales(plot)$x$limits)) {
xrel = F
}
if (isTRUE (yrel)) {
y_lims <- layer_scales(plot)$y$limits
y_pos <- (y_lims [[2]] - y_lims [[1]]) * y
} else if (!isTRUE (yrel)) {
y_pos <- y
}
if (isTRUE (xrel)) {
x_lims <- layer_scales(plot)$x$limits
x_pos <- (x_lims [[2]] - x_lims [[1]]) * x
} else if (!isTRUE (xrel)) {
x_pos <- x
}
plot +
annotate (geom = "text", x = x_pos, y = y_pos, label = title, hjust = 0, vjust = 1, family = font, size = text_size, ...)
}
library(cairo)
library(Cairo)
library(IBL)
?IBL_title
