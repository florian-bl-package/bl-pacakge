# read data ####
# load field data
Orthoptera <- read.xlsx ("U:/Günztal/Günztal/Auswertung_Daten/Geländedaten/GünztalData_2020.xlsx", sheet = "Orthoptera")
Lepidoptera <- read.xlsx ("U:/Günztal/Günztal/Auswertung_Daten/Geländedaten/GünztalData_2020.xlsx", sheet = "Lepidoptera")
# load spatial study plots (geopackage)
study_plots <- st_read ("U:/Günztal/Günztal/Auswertung_Daten/Geodaten/Probeflächen2020_Tagfalter_Heuschrecken.gpkg")
# load elevation data
elevationN <- raster ("U:/Günztal/Günztal/Auswertung_Daten/Geodaten/elevation/N48E010.hgt")
elevationS <- raster ("U:/Günztal/Günztal/Auswertung_Daten/Geodaten/elevation/N47E010.hgt")
# merge elevation scenes
elevation <- raster::merge (elevationN, elevationS)
## data compability and conversation
# set CRS to Gauss-Krüger 4 and clip elevation with buffered study plots (reduces computational power lateron)
GK4 <- CRS("+init=epsg:31468")
elevation_GK4 <- elevation %>%
projectRaster(crs=GK4) %>%
raster::crop (y = st_buffer(study_plots, dist = 200))
# have a look
mapview(study_plots) + mapview (elevation_GK4)
## generate indices from elevation
# compute heatload and topographic position index
heat_load <- hli(elevation_GK4)
topographic_position <- tpi (elevation_GK4, scale = 3) # scale sets the focal radius in pixels
## join spatial data
glo0 <- # "günztal lepidoptera orthoptera"
study_plots %>% transmute (
ID = as.factor (FID_1),
elevation = as.numeric (extract (elevation_GK4, study_plots, fun = mean)),
heat_load = as.numeric (extract (heat_load, study_plots,fun = mean)),
topographic_position = as.numeric (extract (topographic_position, study_plots,fun = mean)),
area = st_area (study_plots),
center = st_centroid(study_plots)$geom,
geom = study_plots$geom
)
# make parameter latitude
glo0$latitude <- st_coordinates(glo0$center)[40:78] # strange: coordinates for x and y organized in one single vector...
# join by ID
Orthoptera$ID <- as.factor (Orthoptera$FID)
Lepidoptera$ID <- as.factor (Lepidoptera$FID)
glo <- left_join (glo0, Orthoptera, by = "ID") %>% left_join (Lepidoptera, by = "ID")
# rename species number cols
glo <-  glo %>% rename (
O_species = Artenzahl.x,
L_species = Artenzahl.y
)
# useful vectors: species groups
orth <- names (Orthoptera[2:22])
lepi <- names (Lepidoptera [3:48])
red_list_L <- read.xlsx ("U:/Günztal/Günztal/Auswertung_Daten/Rote Listen/rl_tagfalter_bayern_gesamt.xlsx") %>%
dplyr::select(RL.BY.2016, Wissenschaftlicher.Name) %>%
drop_na()
red_list_L <- subset (red_list_L, red_list_L$Wissenschaftlicher.Name %in% lepi)
lepiT <- subset (red_list_L, red_list_L$RL.BY.2016!="*") $ Wissenschaftlicher.Name
red_list_O <- read.xlsx ("U:/Günztal/Günztal/Auswertung_Daten/Rote Listen/rl_heuschrecken_bayern_gesamt.xlsx") %>%
dplyr::select(RL.BY.2016, Wissenschaftlicher.Name) %>%
drop_na()
red_list_O <- subset (red_list_O, red_list_O$Wissenschaftlicher.Name %in% orth)
orthT <- subset (red_list_O, red_list_O$RL.BY.2016!="*") $ Wissenschaftlicher.Name
# count threatened species
glo$threatO <- glo  %>% as.data.frame () %>% dplyr:: select (orthT) %>% rowSums (na.rm=T)
glo$threatL <- glo  %>% as.data.frame () %>% dplyr:: select (lepiT) %>% rowSums (na.rm=T)
for (i in 1:length(glo$ID)){
tspO <- glo [i,]  %>% as.data.frame () %>% dplyr:: select (orthT) %>% rowSums (na.rm=T)# count threatened species in focal plot
o_plots[i, "NO_ENDANGERED"] <- length (endangered_in_plot)
}
# useful vectors: environmental parameters
envi <-  c ("elevation", "heat_load", "topographic_position", "area", "latitude")
