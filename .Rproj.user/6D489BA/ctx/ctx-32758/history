predLatO <- ggpredict (mLatO, "latitude[xx]")
lat_plot +
geom_line (aes(x = x, predicted), data = predLatL, col =  IBL_blue (3)) +
geom_ribbon(aes(x = x, ymin = conf.low, ymax = conf.high), data = predLatL, fill =  IBL_blue (5), alpha = .3) +
geom_line (aes(x = x, predicted), data = predLatO, col =  IBL_green (3)) +
geom_ribbon(aes(x = x, ymin = conf.low, ymax = conf.high), data = predLatO, fill =  IBL_green (5), alpha = .3) +
# add "legend"
annotate_text ( label = "Lepidoptera***", x = 0.95, y = 0.98, color = IBL_blue (3), size = 18, family = "Chantilly",  hjust = 1) +
annotate_text ( label = "Orthoptera***", x = 0.95, y = 0.9, color = IBL_green (3), size = 18, family = "Chantilly",  hjust = 1)
## latitude plot - threatened species
lat_plotT <-
ggplot (glo_plot) +
geom_point (mapping = aes (x = latitude, y = threatL), fill = IBL_blue (1), pch = 21, size = 3) +
geom_point (mapping = aes (x = latitude, y = threatO), fill = IBL_green (1), pch = 21, size = 3) +
#add some aesthetics
ylab ("Threatened Species") +
xlab ("Latitude [GK]") +
IBL_y_scale (air = T) +
IBL_x_scale() +
IBL_theme()
# glm
xx <- seq (min (glo$latitude), max (glo$latitude), length.out = 120) # make continuous vector for x-axis
mLatLT <- glm (threatL ~ latitude, data = glo, family = "poisson")
mLatLT %>% summary
mLatOT <- glm (threatO ~ latitude, data = glo, family = "poisson")
mLatOT %>% summary
predLatLT <- ggpredict (mLatLT, "latitude[xx]")
predLatOT <- ggpredict (mLatOT, "latitude[xx]")
lat_plotT +
geom_line (aes(x = x, predicted), data = predLatLT, col =  IBL_blue (3)) +
geom_ribbon(aes(x = x, ymin = conf.low, ymax = conf.high), data = predLatLT, fill =  IBL_blue (5), alpha = .3) +
geom_line (aes(x = x, predicted), data = predLatOT, col =  IBL_green (3)) +
geom_ribbon(aes(x = x, ymin = conf.low, ymax = conf.high), data = predLatOT, fill =  IBL_green (5), alpha = .3) +
# add "legend"
annotate_text ( label = "Lepidoptera***", x = 0.95, y = 0.98, color = IBL_blue (3), size = 18, family = "Chantilly",  hjust = 1) +
annotate_text ( label = "Orthoptera*", x = 0.95, y = 0.9, color = IBL_green (3), size = 18, family = "Chantilly",  hjust = 1)
IBL_draw_plot (lat_plot, lat_plotT)
IBL_draw_plot (list (lat_plot, lat_plotT))
