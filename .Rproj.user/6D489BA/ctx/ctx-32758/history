list.save (GLO_dataset,
file = "U:/Günztal/Günztal/Auswertung_Daten/R/GLO_dataset.rds")
# load packages ####
# ggf. müssen Pakete zunächst installiert werden, e.g.
# install.packages ("tidyverse")
library (tidyverse) # tidy Umgebung
library (lme4) # Paket für mixed models
library (MuMIn) # model averaging
library (openxlsx) # speichern von Excel-Dateien
library (ggeffects) # dieses Paket wird zur Berechnung der Konfidenzintervalle genutzt
# make some data ####
## Erstelle diverse Variablen
set.seed (5343)
dep <- rpois (120, 5)
v1 <- (runif (120, 3, 7) * ((dep^2 + 1) / 10))
v2 <- (rnorm (120, 1, 0.1) / (dep + 1) ) %>% scale ()
v3 <- runif (120, 2, 4) %>% scale ()
v4 <- (seq (1, 10, length.out = 120) * rnorm (120, 1, 0.2)) %>% scale ()
rfac <- rep (c ("A", "B", "C", "D"), 30)
depend <- dep + c (rep (0, 14), 1)
## Erstelle Datensatz
dat <- data.frame(depend = depend, var1 = v1, var2 = v2, var3 = v3, var4 = v4, rfac = rfac)
# statistics ####
## mixed model
m1 <- glmer (depend ~ var1 + var2 + var3 + var4 + (1|rfac),
data = dat, family = "poisson")
summary (m1)
## dredge
options(na.action = na.fail)
d1 <- dredge (m1)
## average model
mavg1 <- model.avg (d1, subset = delta < 2, fit = TRUE)
summary (mavg1)
# Confidence intervals ####
# Problem: meine Recherche hat ergeben, dass es (vermutlich?) keine
# Möglichkeit gibt, für average models ein Konfidenzinterval
# zu berechnen. Ersatzweise nutze ich hier ein neues "full model",
# welches alle Variablen aus dem average model enthält. Nicht optimal,
# aber der einzige Work-around, den ich gefunden habe.
#
# Sollte es DOCH jemand eine Korrekte Möglichkeit finden, Konfidenzintervalle für
# average models zu berechnen, wird um Rückmeldung gebeten.
# Disclaimer: man wird vieles finden à la "2 * Standardfehler". Das ist aber
# für GLMMs nicht korrekt!
mhelp <- glmer (depend ~ var1 + var2 + var3 + (1|rfac), # ersatzmodell für average model
data = dat, family = "poisson")
## Vergleiche Modelle
summary (mhelp)
summary (mavg1)
# --> es gibt Unterschiede, die in der Praxis aber ggf. nicht wirklich zu Bemerken sind
# (siehe Vergleichsplot unten)
# Vorhersagen mit Konfidenzintervall (95 %) für das Ersatzmodell,
# hier am Beispiel der Variable var2.
# Man kann "xx" auch weglassen; im Zweifel führt das aber zu
# weniger smoothen Kurven.
xx <- seq (min (dat$var2), max (dat$var2), length.out = 120) # make continuous vector for x-axis
pred1 <- ggpredict (mhelp, "var2 [xx]")
pred1 # eine Art Summary-Ausgabe
pred1$predicted # tatsächliche Länge und Werte der prediction
# für mehr Info siehe
? ggpredict
# Plotting ####
# set theme for plotting
simple_theme <-     theme (panel.background = element_blank(), # esthetics of the figure
axis.line = element_line(),
panel.border = element_rect (fill = NA))
## plot average model
# estimates of average model
avg_estim <- summary (mavg1) $ coefmat.full [,1]
intercept <- avg_estim [1]
est1 <- avg_estim [2]
est2 <- avg_estim [3]
est3 <- avg_estim [4]
REST <- mean (dat$var1)*est1 + mean (dat$var3) + est3
pavg <- ggplot (mapping = aes (x = var2, y = depend)) +
geom_point(data = dat) + # Scatterplot
geom_line (aes (x = xx, # Regressionsgerade
y = exp (intercept + est2 * xx + REST))) + # formula for curve (siehe Anleitung Abbildung Poisson-GLMM)
simple_theme
pavg
## plot ersatz-Modell mit Konfidenzintervallen
p1 <- ggplot (mapping = aes ()) +
geom_point(aes (x = var2, y = depend), data = dat) +
geom_line (aes(x = x, predicted), data = pred1) +
geom_ribbon(aes(x = x, ymin = conf.low, ymax = conf.high), data = pred1, alpha = .3) +
simple_theme
p1
# zum Vergleich kann man das average model (hier in rot) einzeichnen -
# in diesem Beispiel sind kaum Unterschiede sichtbar;
# wird also im Zweifel keinen Gutachter stören (?)
p1 + geom_line (aes (x = xx,
y = exp (intercept + est2 * xx + REST)),
colour = "red")
# Data Export for sigma plot ####
attach (pred1)
SP_reg <- data.frame(x, predicted, conf.low, conf.high) # regression line + CI Data Table
detach (pred1)
exp_dat <- list (original_data = dat, regression_data = SP_reg) # Erstelle Liste mit allen zu exportierenden Datensätzen
write.xlsx(x = exp_dat, file = "PutYourPath.xlsx") # ersetze PutYourPath durch den Ort, an dem du die Datentabelle abspeichern möchtest
