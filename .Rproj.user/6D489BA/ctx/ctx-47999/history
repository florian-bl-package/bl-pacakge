single_column <- 90         # in mm; Elsevier
double_column <- 190        # in mm; Elsevier
singleAndHalf_column <- 140 # in mm; Elsevier
setwd ("U:/Promotion/Dissertation im engeren Sinne/05 statistic/fumy_kaempfer_fartmann_orthoptera")
o_plots <- st_read ("o_plots_processed.gpkg")
o_plots <- o_plots %>% data.frame () %>% select (-geom)
# COMPARISON: species number in landuse types // barplots####
species_no_barplot_data <- IBL_barplot_dat (input_frame = o_plots, focal_var = "NO_ORTHO", group_var1 = "TYPE", error_bar = T)
species_no_barplot_data $ group_TYPE <- c ("HAY", "PASTURE", "WET")
species_number_plot <- species_no_barplot_data %>%
ggplot (mapping = aes (x = group_TYPE, y = NO_ORTHO)) +
geom_col (position = "dodge2", fill = IBL_blue(2), color = "black", width = 0.7) +
geom_errorbar(aes (ymin = NO_ORTHO - SE_NO_ORTHO, ymax = NO_ORTHO + SE_NO_ORTHO), width = 0.3) +
IBL_y_scale (sides = "l", air = F, limits = c (0, 15)) +
labs (x = "", y = "Species number") +
IBL_signi (c ("a", "b", "c")) +
IBL_theme (text.size = 16, axis.text.size = 16)
# COMPARISON: CFI in landuse types ####
## ACHTUNG: wie mit empty values in wetland umgehen? NA -> wetlands werden "zu gut" bewertet. "0" -> wetlands werden "zu schlecht" bewertet. conservatively --> set to lowest sfi in study?
## o_plots_SFI_conservative - NA auf 15.82 gesetzt; das ist der niedrigste SFI in der Studie. Ist als Konservativ anzusehen.
o_plots_SFI_conservative <- o_plots
o_plots_SFI_conservative$CFI_best <- o_plots_SFI_conservative$CFI_best %>% replace_na (15.82)
CFI_barplot_data <- IBL_barplot_dat(input_frame = o_plots_SFI_conservative, focal_var = "CFI_best", group_var1 = "TYPE", error_bar = T)
CFI_barplot_data $ group_TYPE <- c ("HAY", "PASTURE", "WET")
CFI_plot <- CFI_barplot_data %>%
ggplot (mapping = aes (x = group_TYPE, y = CFI_best)) +
geom_col (position = "dodge2", fill = IBL_blue(2), color = "black", width = 0.7) +
geom_errorbar(aes (ymin = CFI_best - SE_CFI_best, ymax = CFI_best + SE_CFI_best), width = 0.3) +
IBL_y_scale (sides = "l", air = F, limits = c (0, 32), major_y = 3) +
labs (x = "", y = "Farmland index") +
IBL_signi (c ("a", "b", "a")) +
IBL_theme (text.size = 16, axis.text.size = 16)
IBL_draw_plot(species_number_plot %>% IBL_title)
# draw plots in 1 panel
fig_1 <- IBL_draw_plot (
list (species_number_plot %>% IBL_title ("a) Species richness"),
CFI_plot %>% IBL_title ("b) Habitat demand")),
plot_rows = 2, plot_distance_y = 5, plot_distance_x = 0
)
