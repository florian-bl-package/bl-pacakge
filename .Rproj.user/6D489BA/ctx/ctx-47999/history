library (openxlsx)                                    #needed to read and store excel files
library (IBL)
# load data ####
setwd ("U:/Promotion/Dissertation im engeren Sinne/05 statistic/fumy_kaempfer_fartmann_orthoptera")
o_plots <- st_read ("o_plots_processed.gpkg")
o_plots <- o_plots %>% data.frame () %>% select (ID, GEBIET, TYPE, LUI, shannon, NO_ORTHO, elevation, heatload_mean, heatload_range, TPI_mean, TPI_range, CFI_best)
#add some jitter for overlaying points at LUI = 0
plot_dat <- o_plots
plot_dat $ LUI <- plot_dat$LUI %>% na_if (0)
plot_dat $ LUI [is.na (plot_dat $ LUI)] <- runif(22)/5
type_data <- list ()
for (i in levels (plot_dat $ TYPE)) {
plot_dat [[i]] <-
plot_dat %>%
as_tibble() %>%
filter (TYPE == i)
}
hay <- type_data [[1]]
past <-type_data [[2]]
wet <- type_data [[3]]
# Stats ####
# hay meadow
spec_no_glob_hay <- glmer (NO_ORTHO ~
LUI + shannon + heatload_range + TPI_range + elevation +
(1|GEBIET),
data = hay, family = "poisson", na.action = na.fail)
dredge_hay <- dredge (spec_no_glob_hay, m.max = 4)
avg_hay <- model.avg (dredge_hay, subset = delta < 3, fit = TRUE)
summary (avg_hay)
# pasture
spec_no_glob_past <- glmer (NO_ORTHO ~
LUI + shannon + heatload_range + TPI_range + elevation +
(1|GEBIET),
data = past, family = "poisson", na.action = na.fail)
dredge_past <- dredge (spec_no_glob_past, m.max = 4)
avg_past <- model.avg (dredge_past, subset = delta < 3, fit = TRUE)
summary (avg_past)
# wetland
spec_no_glob_wet  <- glmer (NO_ORTHO ~
LUI + shannon + heatload_range + TPI_range + elevation +
(1|GEBIET),
data = wet, family = "poisson", na.action = na.fail)
dredge_wet <- dredge (spec_no_glob_wet, m.max = 4)
dredge_wet
best_wet <- glmer (getCall(dredge_wet, 1), data = wet, family = "poisson")
summary (best_wet)
rcompanion::nagelkerke (best_wet, null = glmer (NO_ORTHO ~ (1|GEBIET),
data = wet, family = "poisson",
na.action = na.fail))
# Plots Alternative I ####
x_lab <- "Landuse Intensity"
y_lab <- "Species Number"
## hay
plot_hay <- hay %>%
ggplot (mapping = aes (x = LUI, y = NO_ORTHO)) +
geom_point (shape = 19,                                       # shape: number (0 - 25) for different *point* symbols
fill = "black",
size = 1) +
IBL_y_scale(limits = c (0,23)) +
IBL_x_scale(limits = c(0, 5)) +
labs (x = x_lab, y = y_lab) +
IBL_theme ()
plot_hay
#add regression line
hay_estimates <- summary (avg_hay) $ coefmat.full [,1]
names (hay_estimates) [1] <- "Intercept"
hay_Intercept <- hay_estimates ["Intercept"]
hay_est_LUI <- hay_estimates ["LUI"]
remove <- c ("Intercept", "LUI")
hay_est_rest <- hay_estimates [! names (hay_estimates) %in% remove]
hay_dat_rest <- hay [names (hay_est_rest)] %>% colMeans ()
hay_rest <- hay_est_rest * hay_dat_rest
plot_hay <- plot_hay + geom_line (aes (x = LUI,
y = exp (hay_Intercept + hay_est_LUI * LUI + sum (hay_rest))),
size = .7)
plot_hay <- IBL_title (plot_hay, "a) hay meadow. ***", x = 0, y = 1)
IBL_draw_plot (plot_hay)
## past
plot_past <- past %>%
ggplot (mapping = aes (x = LUI, y = NO_ORTHO)) +
geom_point (shape = 19,                                       # shape: number (0 - 25) for different *point* symbols
fill = "black",
size = 1) +
IBL_y_scale(limits = c (0,23)) +
IBL_x_scale(limits = c(0, 5)) +
labs (x = x_lab, y = y_lab) +
IBL_theme ()
plot_past
plot_past <- IBL_title (plot_past, "b) Pasture. n.s.", x = 0, y = 1)
IBL_draw_plot (plot_past)
## wet
plot_wet <- wet %>%
ggplot (mapping = aes (x = LUI, y = NO_ORTHO)) +
geom_point (shape = 19,                                       # shape: number (0 - 25) for different *point* symbols
fill = "black",
size = 1) +
IBL_y_scale(limits = c (0,23)) +
IBL_x_scale(limits = c(0, 5)) +
labs (x = x_lab, y = y_lab) +
IBL_theme ()
plot_wet
#add regression line
estimates <- summary (best_wet) $ coefficients [,1]
names (estimates) [1] <- "Intercept"
Intercept <- estimates ["Intercept"]
est_LUI <- estimates ["LUI"]
remove <- c ("Intercept", "LUI")
est_rest <- estimates [! names (estimates) %in% remove]
dat_rest <- wet [names (est_rest)] %>% colMeans ()
rest <- est_rest * dat_rest
plot_wet <- plot_wet + geom_line (aes (x = LUI,
y = exp (Intercept + est_LUI * LUI + sum (rest))),
size = .7)
plot_wet <- IBL_title (plot_wet, "c) Wetland. **", x = 0, y = 1)
IBL_draw_plot (plot_wet)
fig02_I <- IBL_draw_plot(list (plot_hay, plot_past, plot_wet))
